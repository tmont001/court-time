# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only backend key (Supabase's newer sb_secret_... key model — never
# a NEXT_PUBLIC_ variable, never used by any browser-facing client). Used
# exclusively by src/lib/supabase/privileged.ts to call RPCs deliberately
# granted only to service_role, such as submit_pilot_inquiry (Phase 32C).
# If unset, those code paths fail closed rather than falling back to the
# public anon key — see the caller for exact behavior.
SUPABASE_SECRET_KEY=

# ── App URL (required for production) ────────────────────────────────────────
# Set this to your production domain (no trailing slash) — e.g. your Vercel
# deployment URL, or a custom domain once one is attached.
# Used to configure Supabase Auth → URL Configuration → Site URL and Redirect
# URLs, and must match the app_url field in supabase/scripts/bootstrap_new_club.sql.
# As of Phase 32D, the Next.js app also reads this directly for SEO:
# metadataBase (root layout), sitemap.xml, and robots.txt all resolve
# canonical/absolute URLs from it. Falls back to https://court-time.app if
# unset, so local dev works without configuring it.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Resend email (optional — in-app notifications are pilot-critical; email is not) ─
# If unset, email delivery is skipped silently. In-app notifications work without Resend.
# Get your API key from resend.com → API Keys. Must NOT have NEXT_PUBLIC_ prefix
# (server-side only — never expose to the browser).
# Domain court-time.app is already verified in Resend; sender is:
#   Court Time <no-reply@court-time.app>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio SMS (optional — in-app notifications are pilot-critical; SMS is not) ─
# If unset, the SMS test in Admin → Settings shows "not configured" and
# SMS delivery is skipped silently. In-app notifications work without Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Stripe Connect — Court Time Payments (Phase 34D-A) ───────────────────────
# Server-only secret key (never a NEXT_PUBLIC_ variable, never used by any
# browser-facing client). Used exclusively by src/lib/stripe/server.ts to
# call the Stripe API for connected-account onboarding. This is Stripe
# Connect (a club collecting from its own Members) — an entirely separate
# Stripe relationship from Court Time's own SaaS billing (club_subscriptions'
# stripe_customer_id/stripe_subscription_id), which this key is not used for.
# If unset:
#   - Admin Settings → Payments → Court Time Payments shows "Not available"
#     (no clickable action — this is checked server-side before the button
#     ever renders, not merely discovered on click).
#   - Ordinary Court Time scheduling (reservations/lessons/events/programs)
#     and Manual payment tracking are entirely unaffected — nothing here
#     gates any existing feature.
# Get your key from the Stripe Dashboard → Developers → API keys (use a
# test-mode secret key, sk_test_..., until real onboarding is verified).
#
# To actually test the Stripe onboarding flow locally, NEXT_PUBLIC_APP_URL
# (below) must be set to your real local URL (e.g. http://localhost:3000).
# If it's left unset, the Account Link's return/refresh URLs fall back to
# the production domain (see NEXT_PUBLIC_APP_URL's own comment) and Stripe
# will redirect your browser to production instead of back to your local
# server — harmless, but the onboarding flow won't visibly complete
# locally until this is set.
STRIPE_SECRET_KEY=

# ── Pilot inquiry workflow (Phase 32C — /contact) ────────────────────────────
# Where the /contact "Request a pilot" form sends its internal operator
# notification. Every inquiry is durably saved to pilot_inquiries regardless
# of whether this is set; if it's unset (or RESEND_API_KEY is unset), the
# email is skipped and the submission still succeeds for the visitor — check
# the pilot_inquiries table directly in that case.
PILOT_INQUIRY_TO_EMAIL=you@court-time.app

# Optional. Server-only secret used to compute a one-way HMAC of the
# request's client-address header (x-forwarded-for / x-real-ip) — never the
# raw address itself, never exposed to the browser — for the abuse-control
# submission throttle on pilot_inquiries. If unset (or no usable address
# header is present, e.g. local dev), the throttle is simply skipped and
# only the duplicate-email-plus-club-name safety check applies; a
# legitimate inquiry is never rejected merely because this is unset.
# Generate with:
#   openssl rand -hex 32
PILOT_INQUIRY_HASH_SECRET=
